# Authentik LDAP outpost compatibility schema.
#
# Defines marker objectClasses corresponding to the authentik LDAP outpost's
# goauthentik.io/ldap/user and goauthentik.io/ldap/group (using RFC 4512
# compliant hyphenated names since slapd requires alphanumeric + hyphens).
#
# Also defines common custom attribute types that authentik users/groups
# typically carry.  Entries use extensibleObject for any additional
# schema-defined attributes.

# OID base: 1.3.6.1.4.1.99999.1 (private/experimental)

# =========================================================================
# Common custom attribute types
# =========================================================================

attributetype ( 1.3.6.1.4.1.99999.1.1
  NAME 'systemMail'
  DESC 'Primary system email address'
  EQUALITY caseIgnoreIA5Match
  SUBSTR caseIgnoreIA5SubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26 )

attributetype ( 1.3.6.1.4.1.99999.1.2
  NAME 'mailAlias'
  DESC 'Email alias address'
  EQUALITY caseIgnoreIA5Match
  SUBSTR caseIgnoreIA5SubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26 )

attributetype ( 1.3.6.1.4.1.99999.1.3
  NAME 'mailList'
  DESC 'Mailing list address'
  EQUALITY caseIgnoreIA5Match
  SUBSTR caseIgnoreIA5SubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26 )

# =========================================================================
# Authentik marker objectClasses
# =========================================================================

objectclass ( 1.3.6.1.4.1.99999.2.1
  NAME 'goauthentik-io-ldap-user'
  DESC 'Authentik LDAP user marker'
  SUP top AUXILIARY
  MAY ( systemMail $ mailAlias $ mailList ) )

objectclass ( 1.3.6.1.4.1.99999.2.2
  NAME 'goauthentik-io-ldap-group'
  DESC 'Authentik LDAP group marker'
  SUP top AUXILIARY
  MAY ( systemMail $ mailAlias $ mailList ) )
